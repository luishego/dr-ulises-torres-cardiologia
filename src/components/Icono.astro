---
/* Iconos de línea, todos sobre un lienzo de 24×24 y en currentColor.
   Viven juntos para que añadir uno nuevo no implique tocar las secciones. */
interface Props { nombre: string; class?: string }
const { nombre, class: clase } = Astro.props;

const TRAZOS: Record<string, string> = {
  // Navegación
  inicio: '<path d="M3.5 10.5 12 4l8.5 6.5"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5h4v5"/>',
  perfil: '<circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.8 7-5.8s7 2.2 7 5.8"/>',
  servicios: '<path d="M20.5 9.2c0 5-8.5 10.3-8.5 10.3S3.5 14.2 3.5 9.2a4 4 0 0 1 7.6-1.7l.9 1.8"/><path d="M12.3 8.4h2.2l1.2 2.6 1.4-3.4 1 1.9h2.3"/>',
  confianza: '<path d="M12 3.5 5 6v5.5c0 4.2 2.9 7.4 7 9 4.1-1.6 7-4.8 7-9V6l-7-2.5Z"/><path d="m9 12 2.2 2.2L15.4 10"/>',
  agendar: '<rect x="3.5" y="5.5" width="17" height="15" rx="2.5"/><path d="M8 3.5v4M16 3.5v4M3.5 10h17"/><path d="m9.5 14.5 1.8 1.8 3.4-3.4"/>',
  // Servicios
  estetoscopio: '<path d="M6 3v5a4 4 0 0 0 8 0V3"/><path d="M6 3H4.5M14 3h1.5"/><path d="M10 12v3a5 5 0 0 0 10 0v-1"/><circle cx="20" cy="10" r="2"/>',
  corazon: '<path d="M12 20.5S3.5 15 3.5 8.9A4.4 4.4 0 0 1 12 6.8a4.4 4.4 0 0 1 8.5 2.1c0 6.1-8.5 11.6-8.5 11.6Z"/>',
  trazo: '<path d="M2 12h3.5l2-6 3 12 2.5-8 2 4H22"/>',
  // Credenciales
  birrete: '<path d="M12 3 2.5 8 12 13l9.5-5L12 3Z"/><path d="M6 10.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5"/>',
  credencial: '<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><circle cx="8.5" cy="11" r="2.2"/><path d="M5 16.2c.7-1.4 2-2.2 3.5-2.2s2.8.8 3.5 2.2M15 9.5h4M15 13h4"/>',
  hospital: '<path d="M3.5 21V8.5L12 3l8.5 5.5V21"/><path d="M9.5 21v-5h5v5"/><path d="M12 8v4M10 10h4"/>',
  medalla: '<circle cx="12" cy="9.5" r="5.5"/><path d="m8.5 14.5-1 6.5 4.5-2.4 4.5 2.4-1-6.5"/>',
  // Otros
  calendario: '<path d="M8 2v3M16 2v3M3.5 9h17M4 5.5h16a1.5 1.5 0 0 1 1.5 1.5v13A1.5 1.5 0 0 1 20 21.5H4A1.5 1.5 0 0 1 2.5 20V7A1.5 1.5 0 0 1 4 5.5Z"/><path d="m9 15 2 2 4-4"/>',
  silueta: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
};

const trazo = TRAZOS[nombre];
if (!trazo) throw new Error(`Icono desconocido: "${nombre}"`);
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={clase} set:html={trazo} />
