---
import Icono from './Icono.astro';
import { HERO } from '../data/contenido';
import { enlaceWhatsapp } from '../data/sitio';
---
<section class="panel" id="inicio" aria-labelledby="t-inicio">
  <div class="panel__inner">
    <div>
      <p class="eyebrow">{HERO.eyebrow}</p>
      <h1 id="t-inicio">{HERO.titulo}</h1>
      <div class="rule"></div>
      <p class="lead">{HERO.lead}</p>
      <div class="cta-row">
        <a class="btn btn--primary btn--lg" href={enlaceWhatsapp()} rel="noopener" target="_blank">
          <Icono nombre="calendario" />
          {HERO.ctaPrimario}
        </a>
        <a class="btn btn--ghost btn--lg" href="#servicios">{HERO.ctaSecundario}</a>
      </div>
    </div>
  </div>
</section>
