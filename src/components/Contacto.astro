---
import { CONTACTO_SECCION as C } from '../data/contenido';
import { enlaceWhatsapp, enlaceCorreo } from '../data/sitio';
---
<section class="panel" id="contacto" aria-labelledby="t-contacto">
  <div class="panel__inner contact">
    <div>
      <p class="eyebrow">{C.eyebrow}</p>
      <h2 id="t-contacto">{C.titulo}</h2>
      <div class="rule"></div>
      <div class="contact__box">
        <p class="lead">{C.lead}</p>
        <div class="cta-row">
          <a class="btn btn--primary btn--lg" href={enlaceWhatsapp()} rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.6 14.1c-.2.7-1.3 1.3-1.9 1.3-.5 0-1.1.2-3.6-.8-3-1.3-4.9-4.4-5-4.6-.2-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .5-.1.7.5l1 2.4c.1.2.1.4 0 .6l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.2 1.4 2.5 1.6.3.1.5.1.6-.1l.9-1c.2-.2.4-.2.6-.1l2.3 1.1c.2.1.4.2.5.3.1.2.1.6-.1 1.1Z"/></svg>
            {C.ctaWhatsapp}
          </a>
          <a class="btn btn--ghost btn--lg" href={enlaceCorreo()}>{C.ctaCorreo}</a>
        </div>
        <div class="alert">
          <b>{C.urgencias.titulo}</b> {C.urgencias.texto}
        </div>
      </div>
    </div>

    <dl class="data">
      {C.datos.map((d) => (
        <div>
          <dt>{d.termino}</dt>
          <dd class={'pendiente' in d && d.pendiente ? 'ph' : undefined}>
            {d.valor}{'cola' in d && d.cola && <> — <span class="ph">{d.cola}</span></>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
