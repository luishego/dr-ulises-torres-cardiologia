---
/* Datos estructurados schema.org/Physician.
   Es lo que alimenta el panel lateral de Google y las búsquedas locales
   («cardiólogo Roma Sur»), que para un consultorio físico pesan más que el
   sitemap.

   Todo sale de sitio.ts y contenido.ts: un dato escrito dos veces acaba
   contradiciéndose, y una contradicción entre el marcado y la página es
   justo lo que Google penaliza.

   Lo que NO está aquí es deliberado. Sin coordenadas verificadas no hay
   geo, y sin reseñas propias no hay aggregateRating (las de Doctoralia son
   de Doctoralia). Inventar cualquiera de las dos es peor que omitirla:
   Google contrasta el marcado contra la realidad. */
import { CONSULTORIO, CONTACTO, HORARIO, META, enlaceDoctorialia } from '../data/sitio';
import { SOBRE, SERVICIOS, CONFIANZA } from '../data/contenido';

const sitio = Astro.site!.href.replace(/\/$/, '');

/* Las cédulas son registro público en la SEP y ya se muestran en la página,
   así que el marcado sólo repite lo que el visitante ve. */
const cedulas = CONFIANZA.credenciales
  .find((c) => c.titulo === 'Cédulas profesionales')?.datos ?? [];

/* Certificación de consejo. La lista mezcla el emisor y una nota de
   verificación con los certificados, así que éstos se reconocen por el
   folio: son los únicos cuyo valor empieza por CMC. */
const consejo = CONFIANZA.credenciales
  .find((c) => c.titulo === 'Certificación de consejo')?.datos ?? [];
const emisor = consejo.find((d) => d.termino === 'Consejo')?.valor;
const certificaciones = consejo.filter((d) => /^CMC/.test(d.valor));

const datos = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  '@id': `${sitio}/#medico`,
  name: SOBRE.nombre,
  description: META.descripcion,
  url: `${sitio}/`,
  logo: `${sitio}/Logo.svg`,
  image: `${sitio}${META.imagen}`,
  telephone: `+${CONTACTO.whatsapp}`,
  email: CONTACTO.correo,
  knowsLanguage: 'es-MX',
  medicalSpecialty: ['Cardiovascular', 'InternalMedicine'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${CONSULTORIO.calle}, ${CONSULTORIO.colonia}`,
    addressLocality: CONSULTORIO.ciudad,
    addressRegion: 'Ciudad de México',
    postalCode: CONSULTORIO.cp,
    addressCountry: 'MX',
  },
  areaServed: {
    '@type': 'City',
    name: CONSULTORIO.ciudad,
  },
  /* El mismo horario que la ficha del mapa muestra en texto. Es lo que
     responde al «¿está abierto ahora?» de una búsqueda local. */
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: HORARIO.dias,
      opens: HORARIO.abre,
      closes: HORARIO.cierra,
    },
  ],
  availableService: SERVICIOS.items.map((s) => ({
    '@type': 'ImagingTest',
    name: s.titulo,
  })),
  identifier: cedulas.map((d) => ({
    '@type': 'PropertyValue',
    name: d.termino,
    value: d.valor,
  })),
  /* hasCredential y no memberOf: estar certificado por un consejo no es lo
     mismo que ser miembro de él, y el vocabulario distingue las dos cosas. */
  hasCredential: certificaciones.map((d) => ({
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'Certificación de consejo',
    name: d.termino,
    identifier: d.valor,
    recognizedBy: { '@type': 'Organization', name: emisor },
  })),
  /* Sin el fragmento: sameAs identifica el perfil, no el enlace profundo a
     la sección de agenda que usan los botones de la página. */
  sameAs: [enlaceDoctorialia().split('#')[0]],
};
---
<script type="application/ld+json" is:inline set:html={JSON.stringify(datos)} />
