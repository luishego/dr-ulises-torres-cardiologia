---
/* Cinco columnas fijas: nunca se desliza. En móvil manda el icono con una
   etiqueta corta, porque los nombres completos no caben a 320px; el nombre
   completo va en aria-label y reaparece como texto a partir de 768px. */
import Icono from './Icono.astro';
import { SECCIONES } from '../data/sitio';

const ICONOS = ['inicio', 'perfil', 'servicios', 'confianza', 'agendar'];
---
<nav class="nav" id="nav" aria-label="Secciones del sitio">
  {SECCIONES.map((s, i) => (
    <a href={`#${s.id}`} aria-label={s.aria} aria-current={i === 0 ? 'true' : undefined}>
      <Icono nombre={ICONOS[i]} />
      <span class="nav__corto">{s.corto}</span><span class="nav__largo">{s.largo}</span>
    </a>
  ))}
</nav>
