---
import Icono from './Icono.astro';
import { CONFIANZA } from '../data/contenido';
---
<section class="panel" id="confianza" aria-labelledby="t-confianza">
  <div class="panel__inner">
    <p class="eyebrow">{CONFIANZA.eyebrow}</p>
    <h2 id="t-confianza">{CONFIANZA.titulo}</h2>
    <div class="rule"></div>
    <p class="lead">{CONFIANZA.lead}</p>

    <div class="grid-3 ">
      {CONFIANZA.credenciales.map((c) => (
        <article class="card cred">
          <div class="cred__head"><Icono nombre={c.icono} />{c.titulo}</div>
          <dl>
            {c.datos.map((d) => (
              <div>
                <dt>{d.termino}</dt>
                <dd class={d.pendiente ? 'ph' : undefined}>{d.valor}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>

    <p class="note">
      Los campos marcados como <span class="ph">pendiente</span> se completan con la documentación
      oficial del Dr. Torres antes de publicar el sitio. Se muestran así a propósito, para que no
      se confundan con datos ya verificados.
    </p>
  </div>
</section>
